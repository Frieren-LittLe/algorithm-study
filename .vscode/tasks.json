{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译当前文件 (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\build.bat",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            },
            "detail": "Visual Studio (MSVC 14.51 x64) 编译当前 .cpp；exe 生成在同目录，体积小、无 pdb"
        },
        {
            "label": "编译并运行当前文件 (MSVC x64)",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\run.bat",
            "args": [
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "编译后直接在终端运行，可直接粘贴题目输入"
        },
        {
            "label": "编译当前文件 (调试符号)",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\build.bat",
            "args": [
                "${file}",
                "dbg"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "带 /Zi 符号的编译，F5 调试（断点）用；会生成 pdb + ilk"
        }
    ]
}
